mcrt portal.timeline 0.3
module corpus.mcrt_portal_timeline.example_02516
policy no_network
metadata { timebase: 25/1 deterministic: true }
timeline Timeline02516 {
  procedural sequence Sequence02516 seed 2516 {
    track Scene { clip PortalArrival from 0s to 8s bind scene.PortalScene9 }
    track Motion { clip Walk from 1s to 7s bind motion.Actor0 }
    track VFX { clip PortalGlow from 2s to 6s bind vfx.Portal8 }
    barrier AllReady at 2s requires [Scene, Motion, VFX]
    branch Outcome at 6s deterministic_by "state_hash" {
      when state.success -> Success
      otherwise -> Restore
    }
    checkpoint Restore at 5s
    replay hash sha256("timeline:02516")
  }
}

mcrt portal.timeline 0.3
module corpus.mcrt_portal_timeline.example_02500
policy no_network
metadata { timebase: 24/1 deterministic: true }
timeline Timeline02500 {
  sequence Sequence02500 {
    track Camera bind scene.MainCamera { clip Establish from 0s to 4s easing ease_in_out }
    track Portal bind scene.PortalA { clip Open from 3s to 7s trim 0.25s..3.75s }
    transition Establish -> Open duration 1s mode crossfade
    branch Choice0 at 5s { when flag("authorized") -> Open otherwise -> Establish }
    sync group Sync1 { Camera, Portal }
    checkpoint CP02500 at 6s restore [Camera, Portal]
  }
}

--- 8S COUPLED MECHANICS EDITORIAL ANNEX ---
Framework: Smithson 8S Coupled Mechanics v1.0.
